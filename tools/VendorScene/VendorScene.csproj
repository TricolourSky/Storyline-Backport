<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>VendorScene</AssemblyName>
    <RootNamespace>VendorScene</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Shaders\*.shader" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ugui_guids.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

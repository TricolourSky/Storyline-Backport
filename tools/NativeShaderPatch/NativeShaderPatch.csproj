<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreConfigFile>$(MSBuildProjectDirectory)\NuGet.Config</RestoreConfigFile>
    <RestorePackagesPath>$(MSBuildProjectDirectory)\.packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AssetsTools.NET">
      <HintPath>$(MSBuildProjectDirectory)\AssetsTools.NET.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
